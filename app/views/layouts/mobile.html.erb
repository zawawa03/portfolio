<!DOCTYPE html>
<html>
  <head>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-CGCWSLB976"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-CGCWSLB976');
    </script>

    <%= yield :head %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
    <%= display_meta_tags(default_meta_tags) %>
  </head>

  <body>
    <div>
      <% if user_signed_in? %>
        <%= render 'shared/mobile_header' %>
      <% else %>  
        <%= render 'shared/before_login_mobile_header' %>
      <% end %>  
      <div class="overflow-auto" id="mobile_main">
        <div class="mt-2 ms-3">
          <%= breadcrumbs separator: " ＞ " %>
        </div>
        <%= render 'shared/flash_message' %>
        <%= yield %>
      </div>  
    </div>  
  </body>
</html>